# Copia este archivo como .env (ignorado por Git) y completa los valores.

# Clave de firma de los tokens de sesión: aleatoria, de al menos 32 bytes y distinta en cada entorno.
# Se puede generar con: openssl rand -hex 32
SACA_TOKEN_SECRETO=

# Correo de activación de cuentas. Sin SPRING_MAIL_HOST el correo queda "no disponible"
# y nunca se simula un envío. Para desarrollo local con Mailpit (docker-compose.correo.yml):
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# SACA_CORREO_REMITENTE=SACA UES <no-responder@saca.local>
# SACA_FRONTEND_URL=http://localhost:5173
# Solo para un servidor SMTP real (proveedor de producción por definir):
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SACA_CORREO_SMTP_AUTH=true
# SACA_CORREO_SMTP_STARTTLS=true
# SACA_CORREO_SMTP_STARTTLS_OBLIGATORIO=true

# Límites de solicitudes. Sin definir se usan los valores por defecto; solo hace falta declarar los
# proxies confiables reales del despliegue y, si se desea, las redes compartidas (CIDR separados por comas).
# SACA_PROXIES_CONFIABLES=
# SACA_IP_REDES_COMPARTIDAS=
# SACA_LIMITE_MULTIPLICADOR_REDES_COMPARTIDAS=10
# SACA_LIMITE_MAX_CLAVES=50000
# SACA_LIMITE_LOGIN_FALLOS_10_MIN=30
# SACA_LIMITE_LOGIN_FALLOS_24_H=200
# SACA_LIMITE_REGISTRO_10_MIN=20
# SACA_LIMITE_REGISTRO_24_H=100
# SACA_LIMITE_ACTIVACION_MIN=30
# SACA_LIMITE_CORREO_HORA=500
